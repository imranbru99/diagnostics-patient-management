APP_NAME="Apex Diagnostics AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="Asia/Dhaka"
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=diagnostics_db
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@apexdiagnostics.test"
MAIL_FROM_NAME="${APP_NAME}"

# ========================================================
# AI HUB CONFIGURATION (imrandevbd/laravel-ai-hub)
# ========================================================
AI_DEFAULT_PROVIDER=gemini
AI_FAILOVER_CHAIN="gemini,openai,anthropic,groq,ollama"
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

AI_ENABLE_REPORT_SUMMARIZATION=true
AI_ENABLE_CRITICAL_VALUE_FLAGGING=true
AI_ENABLE_OCR_REQUISITION=true
AI_ENABLE_DOCTOR_COPILOT=true
AI_ENABLE_PATIENT_CHAT=true

# ========================================================
# UNICODE PDF (imrandevbd/laravel-unicode-pdf)
# ========================================================
UNICODE_PDF_ENGINE=mpdf
UNICODE_PDF_DEFAULT_FONT=SolaimanLipi
UNICODE_PDF_FALLBACK_FONTS="Nikosh,Kalpurush,Amiri,DejaVuSans"
UNICODE_PDF_RTL_SUPPORT=true

# ========================================================
# ATTENDANCE HUB (imrandevbd/laravel-attendance-hub)
# ========================================================
ATTENDANCE_DEVICE_IP=192.168.1.201
ATTENDANCE_DEVICE_PORT=4370
ATTENDANCE_PROTOCOL=adms
ATTENDANCE_AUTO_SYNC_INTERVAL=15

# ========================================================
# UNIVERSAL SLUG (imrandevbd/laravel-universal-slug)
# ========================================================
UNIVERSAL_SLUG_LOCALE_AWARE=true
UNIVERSAL_SLUG_ATOMIC_LOCK=true

VITE_APP_NAME="${APP_NAME}"
